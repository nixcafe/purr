sDirect mkFlake — Also works standalone with the simple mkFlake APIModule System — Compose shells, checks, packages, and more with reusable modulesPre-configured Batteries — git-hooks.nix, dev shells, formatters all set up","title":"Features","titles":["purr"],"type":"section"},"3":{"category":"","href":"/#installation","subtitle":"","text":" Add purr to your flake inputs: {\n  inputs.purr.url = \"https://flakehub.com/f/nixcafe/purr/0.1.*.tar.gz\";\n}","title":"Installation","titles":["purr"],"type":"section"},"4":{"category":"","href":"/#via-flake-parts","subtitle":"","text":" {\n  inputs = {\n    nixpkgs.url = \"...\";\n    purr.url = \"...\";\n    flake-parts.url = \"...\";\n  };\n\n  outputs = inputs:\n    inputs.flake-parts.lib.mkFlake { inherit inputs; } {\n      imports = [ inputs.purr.flakeModules.default ];\n    };\n}","title":"Via flake-parts","titles":["purr","Usage"],"type":"section"},"5":{"category":"","href":"/#via-mkflake","subtitle":"","text":" {\n  inputs = {\n    nixpkgs.url = \"...\";\n    purr.url = \"...\";\n  };\n\n  outputs = inputs:\n    inputs.purr.lib.mkFlake {\n      inherit inputs;\n      src = ./develop;\n    };\n}","title":"Via mkFlake","titles":["purr","Usage"],"type":"section"},"6":{"category":"","href":"/#project-structure","subtitle":"","text":" purr expects the following layout under your src directory: develop/\n├── shells/\n│   └── default/\n│       └── default.nix     # Dev shell\n├── checks/\n│   └── git-hooks/\n│       └── default.nix     # Pre-commit hooks\n└── packages/\n    └── ...                 # Custom packages Each .nix file is auto-discovered and wired into the flake.","title":"Project Structure","titles":["purr"],"type":"section"}},"dirtCount":0,"index":[["#",{"2":{"6":3}}],["└──",{"2":{"6":6}}],["│",{"2":{"6":4}}],["├──",{"2":{"6":2}}],["layout",{"2":{"6":1}}],["lib",{"2":{"1":1,"4":1,"5":1}}],["each",{"2":{"6":1}}],["expects",{"2":{"6":1}}],["everything",{"2":{"1":1}}],["via",{"3":{"4":1,"5":1}}],["];",{"2":{"4":1}